{
  "name": "cp-js",
  "version": "1.1.0",
  "description": "High-performance Multi-Platform Competitive Programming in JavaScript (Node.js) supporting Codeforces, LeetCode, and CodeChef",
  "main": "run.js",
  "scripts": {
    "start": "node run.js",
    "solve": "node run.js",
    "test": "node run.js",
    "template": "node run.js cp",
    "template:lc": "node run.js leetcode",
    "pick": "node practice/pick.js",
    "pick:all": "node practice/pick.js --platform all",
    "pick:cf": "node practice/pick.js --platform codeforces",
    "pick:lc": "node practice/pick.js --platform leetcode",
    "pick:cc": "node practice/pick.js --platform codechef",
    "verify": "node practice/verify.js",
    "verify:ref": "node practice/verify.js --ref",
    "solve:day": "node practice/solve.js",
    "ship:day": "node practice/ship.js",
    "explain": "node practice/explain.js",
    "visualizer": "node visualizer/server.js",
    "dashboard": "node visualizer/server.js",
    "view": "node visualizer/server.js",
    "mcp": "node practice/mcp/server.js",
    "remind": "powershell -NoProfile -ExecutionPolicy Bypass -File practice/remind.ps1",
    "remind:install": "powershell -NoProfile -ExecutionPolicy Bypass -File practice/remind-install.ps1",
    "knowledge": "node practice/knowledge.js",
    "knowledge:sync": "node practice/knowledge.js --sync",
    "submit": "node practice/playwright/submit.js",
    "submit:dry": "node practice/playwright/submit.js --dry-run",
    "submit:failed": "node practice/playwright/submit.js --failed-only",
    "submit:retry": "node practice/playwright/submit.js --failed-only",
    "submit:parallel": "node practice/playwright/submit.js --parallel",
    "submit:lc": "node practice/playwright/submit.js --platform leetcode",
    "submit:cf": "node practice/playwright/submit.js --platform codeforces",
    "submit:cc": "node practice/playwright/submit.js --platform codechef",
    "submit:auth": "node practice/playwright/auth.js",
    "submit:status": "node practice/playwright/submit.js --status",
    "auto": "node practice/auto.js",
    "auto:retry": "node practice/auto.js --retry",
    "sync:cf": "node practice/syncVerdicts.js",
    "monitor": "node practice/monitor.js",
    "monitor:stream": "node practice/monitor.js --stream",
    "monitor:once": "node practice/monitor.js --once",
    "auth:status": "node practice/playwright/auth.js --status",
    "test:playwright": "node --test practice/playwright/submit.test.js",
    "test:unit": "node --test \"practice/**/*.test.js\"",
    "test:ui": "node visualizer/test/ui.e2e.mjs"
  },
  "keywords": [
    "competitive-programming",
    "codeforces",
    "leetcode",
    "codechef",
    "atcoder",
    "cses",
    "algorithms",
    "data-structures",
    "nodejs",
    "javascript"
  ],
  "author": "AKSHAYKUMAR SHIVAKUMAR PATIL",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "playwright": "^1.63.0"
  }
}
